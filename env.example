# Copia este archivo como .env y completa los valores

# Database (Supabase Postgres) — https://supabase.com
DATABASE_URL=postgresql://postgres.[ref]:[password]@....pooler.supabase.com:6543/postgres

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin (login simple; Auth.js llega después)
ADMIN_EMAILS=tu@email.com
ADMIN_PASSWORD=cambia-esta-contraseña
AUTH_SECRET=cambia-este-secreto

# Supabase Storage (fotos de productos en producción)
# Project URL: Dashboard → Project Settings → API → Project URL
# Solo el dominio, SIN /rest/v1/ al final: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# service_role (secret): Dashboard → Project Settings → API → service_role
# Nunca la pegues en el frontend ni en git. Solo en .env y en Vercel.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cuentas de clientes con Google (Auth.js)
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (Aplicación web)
# URI de redirección autorizado: http://localhost:3000/api/auth/callback/google
#   (y en producción: https://tu-dominio.com/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Solo si NO publicas en Vercel (otro hosting o `npm start` local):
# AUTH_TRUST_HOST=true

# Fase 2+
# MERCADOPAGO_ACCESS_TOKEN=
# RESEND_API_KEY=
# SHIPPING_COST_MXN=9900
# NEXT_PUBLIC_WHATSAPP_NUMBER=52XXXXXXXXXX
