# Copia este archivo como .env y completa los valores

# Database (Supabase Postgres) — https://supabase.com
DATABASE_URL=postgresql://postgres.[ref]:[password]@....pooler.supabase.com:6543/postgres

# Stripe (solo para checkout temporal y migración con npm run db:seed)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin (login simple; Auth.js llega después)
ADMIN_EMAILS=tu@email.com
ADMIN_PASSWORD=cambia-esta-contraseña
AUTH_SECRET=cambia-este-secreto

# Supabase Storage (fotos de productos en producción)
# Project URL: Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# service_role (secret): Dashboard → Project Settings → API → service_role
# Nunca la pegues en el frontend ni en git. Solo en .env y en Vercel.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Fase 2+
# MERCADOPAGO_ACCESS_TOKEN=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# RESEND_API_KEY=
# SHIPPING_COST_MXN=9900
# NEXT_PUBLIC_WHATSAPP_NUMBER=52XXXXXXXXXX
